{
  "name": "valrify",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter @valrify/api --filter @valrify/web dev",
    "build": "pnpm --workspace-concurrency=1 -r --sort build",
    "lint": "pnpm --workspace-concurrency=1 -r --if-present lint",
    "test": "pnpm --workspace-concurrency=1 -r --if-present test",
    "test:integration": "pnpm --filter @valrify/api test:integration",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @valrify/api db:generate",
    "db:migrate": "pnpm --filter @valrify/api db:migrate",
    "db:seed": "pnpm --filter @valrify/api db:seed",
    "db:backup": "node apps/api/scripts/local-db-backup.mjs backup",
    "db:restore:test": "node apps/api/scripts/local-db-backup.mjs verify"
  },
  "devDependencies": { "tsx": "^4.20.6", "typescript": "^5.9.3" }
}
